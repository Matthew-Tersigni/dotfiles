# Append to ~/.ssh/config (export-secrets already copies your real config).
# Host alias used by personal repos: git@personal-github:Matthew-Tersigni/...

Host personal-github
  HostName github.com
  User git
  IdentityFile ~/.ssh/ters_tech
  IdentitiesOnly yes

# Optional: Magnet bastions / SSM (from EC2) — needs AWS SSO profiles imported
